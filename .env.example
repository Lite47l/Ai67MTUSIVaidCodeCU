# Docker Compose reads .env automatically. For go run, export these variables.
ADDR=127.0.0.1:8080
DB_PATH=data/pulse.db
COOKIE_SECURE=false
WEBHOOK_SECRET=
TALLY_SIGNING_SECRET=
TALLY_INTERN_FORM_ID=
TALLY_MENTOR_FORM_ID=
INTERN_FORM_URL=
MENTOR_FORM_URL=
# Local Go -> Python: http://127.0.0.1:8000
# Compose -> Python: http://agent:8000
AGENT_URL=
AGENT_TOKEN=
AGENT_REFERENCE_MODE=0
# Optional OpenAI-compatible chat completions endpoint and model name.
AGENT_LLM_URL=
AGENT_LLM_MODEL=
AGENT_LLM_TOKEN=
# Reviewed label file for local Python runs.
AGENT_REVIEWED_LABELS=
