{
  "$defs": {
    "ConversationPlan": {
      "additionalProperties": false,
      "properties": {
        "month": {
          "maximum": 6,
          "minimum": 1,
          "title": "Month",
          "type": "integer"
        },
        "situation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Situation",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Questions",
          "type": "array"
        },
        "actionType": {
          "enum": [
            "weekly_1on1",
            "reduce_load",
            "clarify_tasks",
            "hr_talk",
            "other"
          ],
          "title": "Actiontype",
          "type": "string"
        },
        "mentorMessage": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Mentormessage",
          "type": "string"
        }
      },
      "required": [
        "month",
        "situation",
        "evidenceIds",
        "questions",
        "actionType",
        "mentorMessage"
      ],
      "title": "ConversationPlan",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "title": "Eventid",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "eventId",
        "field",
        "value"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "enum": [
            "positive",
            "attention",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "severity",
        "title",
        "evidence"
      ],
      "title": "Signal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "requestId": {
      "title": "Requestid",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "summary": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "maxItems": 100,
      "title": "Signals",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Recommendations",
      "type": "array"
    },
    "conversationPlans": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ConversationPlan"
          },
          "maxItems": 6,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversationplans"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "revision",
    "summary",
    "signals",
    "recommendations"
  ],
  "title": "AnalyzeResult",
  "type": "object"
}
