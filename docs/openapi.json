          "internId": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "source": {
            "const": "intern"
          },
          "scores": {
            "type": "object",
            "properties": {
              "taskClarity": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
